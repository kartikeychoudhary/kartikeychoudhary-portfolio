# Public (build-time) vars for the contact form.
# Copy this file to `.env` and fill in real values before `npm run dev` or `npm run build`.
# `.env` is git-ignored.

# Cloudflare Turnstile site key (public). Get it from the Turnstile dashboard.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_YOUR_SITE_KEY

# Deployed Cloudflare Worker URL (see workers/contact/README.md).
VITE_WORKER_URL=https://portfolio-contact.YOUR_SUBDOMAIN.workers.dev
